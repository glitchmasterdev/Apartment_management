SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx # Server-only; never expose to browser code.
# Legacy Supabase projects can use SUPABASE_SERVICE_ROLE_KEY instead.
SECRET_KEY=your-jwt-secret-min-32-chars
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com # Must be a verified sender in your Resend dashboard.
APP_URL=https://your-domain.vercel.app
ALLOWED_ORIGIN=https://your-domain.vercel.app

# Safaricom Daraja STK Push — server-side only; never add these to browser code.
MPESA_ENVIRONMENT=sandbox # use production after Safaricom go-live approval
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-daraja-passkey
MPESA_CALLBACK_SECRET=generate-a-long-random-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@nairobrentals.com
